---
import Home from '@theme/views/Home.astro';
import { getProjects } from '../../lib/projects';
import { getPageText } from '../../lib/pages';
import { langPaths } from '../../lib/i18n';
import type { Locale } from '../../../site.config';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Locale;
const [projects, intro] = await Promise.all([getProjects(lang), getPageText('home', lang)]);
---

<Home lang={lang} projects={projects} intro={intro} />
