---
// <Callout type="note|tip|warning">...</Callout>
interface Props { type?: 'note' | 'tip' | 'warning' }
const { type = 'note' } = Astro.props;
---

<aside class:list={['callout', type]}><slot /></aside>

<style>
  .callout {
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
  }
  .callout :global(p) { margin: 0; }
  .tip { border-left-color: #2f9e44; }
  .warning { border-left-color: #e8590c; }
</style>
