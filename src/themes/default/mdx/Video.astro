---
// <Video src="https://www.youtube.com/watch?v=..." title="..." />
// <Video src="/videos/demo.webm" />           (fichier dans public/)
interface Props { src: string; title?: string }
const { src, title = 'Video' } = Astro.props;

const yt = /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/.exec(src)?.[1];

const srcdoc = yt
  ? `<style>*{margin:0;padding:0;overflow:hidden}html,body{height:100%}img,span{position:absolute;inset:0;margin:auto}img{width:100%;height:100%;object-fit:cover}span{height:1.5em;width:1.5em;text-align:center;font:48px/1.5 sans-serif;color:#fff;text-shadow:0 0 .5em #000}</style>` +
    `<a href="https://www.youtube-nocookie.com/embed/${yt}?autoplay=1"><img src="https://i.ytimg.com/vi/${yt}/hqdefault.jpg" alt="${title}" loading="lazy"><span>▶</span></a>`
  : undefined;
---

{
  yt ? (
    <div class="video">
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${yt}?autoplay=1`}
        srcdoc={srcdoc}
        title={title}
        loading="lazy"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : (
    <video class="video" src={src} controls preload="metadata" title={title} />
  )
}

<style>
  .video { aspect-ratio: 16 / 9; width: 100%; border-radius: var(--radius); overflow: hidden; background: #000; }
  .video iframe { width: 100%; height: 100%; border: 0; display: block; }
</style>
